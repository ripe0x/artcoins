# ─────────────────────────────────────────────────────────────────
# artcoins launcher ui (Vite)
# Copy this file to ui/.env and fill in the values:  cp .env.example .env
#
# EVERYTHING here is compiled into the public bundle (anything prefixed VITE_ is readable by every
# visitor). Never put a secret in it.
# ─────────────────────────────────────────────────────────────────

# ── WalletConnect Cloud project ID (required) ─────────────────────
# Public by design: it identifies the app to WalletConnect, it does not grant anything. Restrict the
# allowed domains in the WalletConnect dashboard.
VITE_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# ── Mainnet rpc for reads (optional) ──────────────────────────────
# Preferably an endpoint you run or proxy, with no key in the url. Without it the ui uses the tenderly
# public gateway (https://mainnet.gateway.tenderly.co), which is rate limited.
# VITE_MAINNET_RPC_URL=https://rpc.example.org

# ── Alchemy (optional, ignored unless restricted) ─────────────────
# An Alchemy key in a public bundle can be copied and used by anyone. It is IGNORED unless you also set
# VITE_ALCHEMY_KEY_RESTRICTED=1, which says: this key is limited to this site's domains (and to the
# eth_call, eth_getLogs and eth_blockNumber style methods) in the Alchemy dashboard.
# VITE_ALCHEMY_API_KEY=
# VITE_ALCHEMY_KEY_RESTRICTED=1

# ── v2 stack (until deployments.generated.ts has it) ──────────────
# Fill after the v2 deploy. Factory, hook and locker are required together, the rest is optional. With
# none of these set the deploy page stays closed and only the current stack's tokens are listed.
# VITE_V2_FACTORY=
# VITE_V2_HOOK=
# VITE_V2_LOCKER=
# VITE_V2_ESCROW=
# VITE_V2_MEV_MODULE=
# VITE_V2_DEV_BUY=
# VITE_V2_VAULT=
# VITE_V2_AIRDROP=
# VITE_V2_POOL_EXTENSION=
# first block to scan for TokenCreatedV2, the v2 factory deploy block
# VITE_V2_DEPLOY_BLOCK=

# ── Default referrer ──────────────────────────────────────────────
# Not an env var: it is a runtime field in public/config.json (defaultReferrer). script-js
# gen-addresses.mjs --check fails when it is not the registry payout wallet.
