# values only, sourced by script/v2/deploy.sh. no key, password or api key belongs here:
# the keystore name is a label, ETHERSCAN_API_KEY comes from the shell.
# TREASURY is the treasury of the 0x4959 stack controller (0xSplits pass-through wallet, treasury of both
# v1 controllers). TREASURY_BPS 8000 splits protocol fees 80/20 treasury / LAYER burn. DEPLOY_FEE 0 makes launches free.
# the controller split and the deploy fee stay owner tunable (setSplit, setDeployFee).
CHAIN_ID=1
RPC_DEFAULT=https://mainnet.gateway.tenderly.co
FOUNDRY_PROFILE=ci
WALLET_MODE=account
KEYSTORE=ripe0x
OWNER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
TREASURY=0x41c3BD8A36f8fE9Bb77900ca02400b32BB35A6A4
TREASURY_BPS=8000
DEPLOY_FEE=0
VERIFY=full
REQUIRE_CLEAN_GIT=true
BROADCAST_DIR=broadcast
DEPLOY_JSON=tmp/v2-deploy-1.json
RECORD=deployments/1.v2.json
