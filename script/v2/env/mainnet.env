# factory deployFee 0.069 eth and defaultProtocolFeeBps 2000, controller 0xd8C6 treasury 0x41c3 (0xSplits
# pass-through wallet, treasury of both v1 controllers) with treasuryBps 8667.
CHAIN_ID=1
RPC_DEFAULT=https://mainnet.gateway.tenderly.co
