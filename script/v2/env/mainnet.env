# values only, sourced by script/v2/deploy.sh. no key, password or api key belongs here:
# the keystore name is a label, ETHERSCAN_API_KEY comes from the shell.
# empty required values make the wrapper refuse. fill TREASURY, TREASURY_BPS, DEPLOY_FEE and
# PROTOCOL_BPS from the owner decision, then review this file in the same commit as the deploy.
CHAIN_ID=1
RPC_DEFAULT=https://mainnet.gateway.tenderly.co
FOUNDRY_PROFILE=ci
WALLET_MODE=account
KEYSTORE=ripe0x
OWNER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
TREASURY=
TREASURY_BPS=
DEPLOY_FEE=
PROTOCOL_BPS=
MIN_PROTOCOL_SKIM_SHARE_BPS=1000
MIN_LP_FEE=3000
REFERRAL_PAYOUT=
VERIFY=full
REQUIRE_CLEAN_GIT=true
BROADCAST_DIR=broadcast
DEPLOY_JSON=tmp/v2-deploy-1.json
RECORD=deployments/1.v2.json
