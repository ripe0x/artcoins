# values only, sourced by script/v2/deploy.sh. no key, password or api key belongs here:
# the keystore name is a label, ETHERSCAN_API_KEY comes from the shell.
# treasury and protocol bps match the 0x4959 stack as read on chain at block 26137826:
# defaultProtocolFeeBps 2000, treasury 0x41c3 (0xSplits pass-through wallet, treasury of both
# v1 controllers). owner decisions 2026-10-14: the split is 80/20 treasury / LAYER burn (the 0x4959
# controller ran 8667/1333) and the deploy fee is 0; both stay owner tunable (setSplit, setDeployFee).
CHAIN_ID=1
RPC_DEFAULT=https://mainnet.gateway.tenderly.co
FOUNDRY_PROFILE=ci
WALLET_MODE=account
KEYSTORE=ripe0x
OWNER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
TREASURY=0x41c3BD8A36f8fE9Bb77900ca02400b32BB35A6A4
TREASURY_BPS=8000
DEPLOY_FEE=0
PROTOCOL_BPS=2000
MIN_PROTOCOL_SKIM_SHARE_BPS=1000
VERIFY=full
REQUIRE_CLEAN_GIT=true
BROADCAST_DIR=broadcast
DEPLOY_JSON=tmp/v2-deploy-1.json
RECORD=deployments/1.v2.json
